<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>FontStashSharp.MoonWorks</PackageId>
    <AssemblyName>FontStashSharp.MoonWorks</AssemblyName>
    <Description>FontStashSharp for MoonWorks</Description>
    <DefineConstants>$(DefineConstants);MOONWORKS;PLATFORM_AGNOSTIC</DefineConstants>
    <OutputPath>bin\MoonWorks\$(Configuration)</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cyotek.Drawing.BitmapFont" Version="$(CyotekDrawingBitmapFontVersion)" />
    <PackageReference Include="StbImageSharp" Version="$(StbImageSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\FontStashSharp\**\*.cs" LinkBase="FontStashSharp" />
    <Compile Remove="..\FontStashSharp\obj\**\*.cs" LinkBase="FontStashSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\MoonWorks\MoonWorks.csproj" />
    <ProjectReference Include="..\..\..\FontStashSharp.Base\src\FontStashSharp.Base\FontStashSharp.Base.csproj" />
    <ProjectReference Include="..\..\..\FontStashSharp.Base\src\FontStashSharp.Rasterizers.StbTrueTypeSharp\FontStashSharp.Rasterizers.StbTrueTypeSharp.csproj" />
  </ItemGroup>
</Project>
